{
  "name": "suppression-census",
  "version": "0.1.0",
  "description": "Counts every way a repo can tell a check to look away, and fails when the count rises. The ratchet that guards the other ratchets.",
  "license": "MIT",
  "author": "Kanav Jain",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "lint",
    "eslint",
    "oxlint",
    "ratchet",
    "ts-ignore",
    "ts-expect-error",
    "skipped-tests",
    "ci",
    "technical-debt",
    "quality-gate"
  ],
  "engines": {
    "bun": ">=1.1",
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "bun test",
    "check": "bun run typecheck && bun run test",
    "prepublishOnly": "bun run check && bun run build"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^5.9.2"
  },
  "bin": {
    "suppression-census": "./dist/cli.js"
  }
}
